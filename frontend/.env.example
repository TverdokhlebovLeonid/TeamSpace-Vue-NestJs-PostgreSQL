# Frontend uses relative /api paths in production (nginx proxies to the backend).
# In dev, Vite proxies /api to http://127.0.0.1:8000 (see vite.config.ts).
VITE_API_BASE_URL=

# For a standalone `docker run` of the frontend image (compose sets this automatically).
BACKEND_URL=http://host.docker.internal:8000
