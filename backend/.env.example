# Runtime
NODE_ENV=development
PORT=8000

# Security
JWT_ACCESS_SECRET=change-me-access-secret-in-prod
JWT_REFRESH_SECRET=change-me-refresh-secret-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# PostgreSQL
POSTGRES_DB=teamspace_app
POSTGRES_USER=teamspace_user
POSTGRES_PASSWORD=teamspace_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Swagger UI (disable in production)
ENABLE_API_DOCS=true

# First administrator (used by `npm run seed:admin` only)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=teamspace_admin
